# Audit Rules for TravelMemory Infrastructure
# These rules monitor critical system changes

# Remove any existing rules
-D

# Buffer Size
-b 8192

# Failure Mode
-f 1

# System calls monitoring
-a always,exit -F arch=b64 -S execve -k exec
-a always,exit -F arch=b64 -S addrinfo_lookup -k network
-a always,exit -F arch=b64 -S socket -k network
-a always,exit -F arch=b64 -S sethostname -k network
-a always,exit -F arch=b64 -S setdomainname -k network

# File monitoring
-w /etc/audit/audit.rules -p wa -k audit_rules_changes
-w /etc/libaudit.conf -p wa -k audit_lib_changes
-w /etc/audisp/ -p wa -k audit_config_changes

# Monitor authentication
-w /etc/group -p wa -k auth_changes
-w /etc/passwd -p wa -k auth_changes
-w /etc/shadow -p wa -k auth_changes
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers

# Monitor SSH configuration
-w /etc/ssh/sshd_config -p wa -k sshd_config_changes

# Monitor system calls
-a always,exit -F arch=b64 -S unlink -S unlinkat -S rename -S renameat -F auid>=1000 -F auid!=4294967295 -k delete
-a always,exit -F arch=b64 -S chmod -F auid>=1000 -F auid!=4294967295 -k permissions
-a always,exit -F arch=b64 -S chown -F auid>=1000 -F auid!=4294967295 -k permissions

# Make the configuration immutable
-e 2
